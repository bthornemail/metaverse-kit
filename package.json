{
  "name": "metaverse-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed, local-first collaborative infinite canvas metaverse built on append-only event traces",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "cd apps/server && tsx --watch src/server.ts",
    "dev:client": "cd apps/client && npm run dev",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist apps/*/node_modules apps/*/dist tools/*/node_modules tools/*/dist",
    "typecheck": "tsc --build",
    "mv-init": "node tools/mv-init/index.js",
    "mv-host": "node tools/mv-host/index.js",
    "mv-client": "node tools/mv-client/index.js",
    "mv-replay": "node tools/mv-replay/index.js",
    "mv-ext32": "node tools/mv-ext32/index.js",
    "mv-portmatroid-project": "node tools/mv-portmatroid-project/index.js",
    "mv-narrative-state-project": "node tools/mv-narrative-state-project/index.js",
    "mv-interaction-tape": "node tools/mv-interaction-tape/index.js",
    "mv-template-generate": "node tools/mv-template-generate/index.js",
    "mv-shared-tape": "node tools/mv-shared-tape/index.js",
    "mv-avatar-role": "node tools/mv-avatar-role/index.js",
    "mv-dialogue-grammar": "node tools/mv-dialogue-grammar/index.js",
    "mv-entity-model": "node tools/mv-entity-model/index.js",
    "mv-world-compose": "node tools/mv-world-compose/index.js",
    "mv-world-graph": "node tools/mv-world-graph/index.js",
    "mv-behavior-grammar": "node tools/mv-behavior-grammar/index.js",
    "mv-world-merge": "node tools/mv-world-merge/index.js",
    "mv-alignment": "node tools/mv-alignment/index.js",
    "mv-reflect": "node tools/mv-reflect/index.js",
    "mv-archetype": "node tools/mv-archetype/index.js",
    "mv-federate": "node tools/mv-federate/index.js",
    "mv-provider-metric": "node tools/mv-provider-metric/index.js",
    "mv-consumer-metric": "node tools/mv-consumer-metric/index.js",
    "mv-wallet-feed": "node tools/mv-wallet-feed/index.js",
    "mv-wallet-feed:test": "node tools/mv-wallet-feed/test.js",
    "mv-pack-demo": "node tools/mv-pack-demo/index.js",
    "mv-proposal-bundle": "node tools/mv-proposal-bundle/index.js",
    "mv-verify-demo": "node tools/mv-verify-demo/index.js",
    "waveform:render": "node scripts/render-waveform.js",
    "waveform:render:test": "node scripts/test-waveform-render.js",
    "waveform:render:verify": "node scripts/verify-waveform-render.js",
    "waveform:render:verify:test": "node scripts/test-waveform-render-verify.js",
    "narrative:render": "node scripts/render-narrative.js",
    "narrative:render:test": "node scripts/test-narrative-render.js",
    "narrative:verify": "node scripts/verify-narrative.js",
    "narrative:verify:test": "node scripts/test-narrative-verify.js",
    "bundle:verify": "node scripts/verify-bundle.js",
    "bundle:verify:test": "node scripts/test-bundle-verify.js",
    "check:portal-contract": "bash scripts/portal-contract-guard.sh",
    "check:active-key": "bash scripts/check-active-key.sh",
    "release:pack": "bash scripts/release-pack.sh",
    "release:verify": "bash scripts/verify-release.sh",
    "release:sbom": "bash scripts/release-sbom.sh",
    "release:docker": "bash scripts/release-docker.sh",
    "release:docker-smoke": "bash scripts/release-docker-smoke.sh",
    "external:tester-smoke": "bash scripts/external-tester-smoke.sh",
    "release:sign": "bash scripts/release-sign.sh",
    "release:verify-signatures": "bash scripts/release-verify-signatures.sh",
    "closure:spine-smoke": "bash scripts/closure-spine-smoke.sh",
    "pretag:v0.1": "bash scripts/pretag-v0.1.sh",
    "narrative:project": "node tools/mv-narrative-state-project/index.js",
    "narrative:golden": "bash scripts/narrative-state-golden.sh",
    "narrative:must-reject": "bash scripts/narrative-state-must-reject.sh",
    "wave16:golden": "bash scripts/wave16-solon-golden.sh",
    "wave16:must-reject": "bash scripts/wave16-solon-must-reject.sh",
    "wave17:golden": "bash scripts/wave17-golden.sh",
    "wave17:must-reject": "bash scripts/wave17-must-reject.sh",
    "wave18:golden": "bash scripts/wave18-golden.sh",
    "wave18:must-reject": "bash scripts/wave18-must-reject.sh",
    "wave19:golden": "bash scripts/wave19-golden.sh",
    "wave19:must-reject": "bash scripts/wave19-must-reject.sh",
    "wave19:world:golden": "bash scripts/wave19-world-golden.sh",
    "wave19:world:must-reject": "bash scripts/wave19-world-must-reject.sh",
    "wave19:graph:golden": "bash scripts/wave19-graph-golden.sh",
    "wave19:graph:must-reject": "bash scripts/wave19-graph-must-reject.sh",
    "wave20:golden": "bash scripts/wave20-golden.sh",
    "wave20:must-reject": "bash scripts/wave20-must-reject.sh",
    "wave21:golden": "bash scripts/wave21-golden.sh",
    "wave21:must-reject": "bash scripts/wave21-must-reject.sh",
    "wave22:golden": "bash scripts/wave22-golden.sh",
    "wave22:must-reject": "bash scripts/wave22-must-reject.sh",
    "wave23:golden": "bash scripts/wave23-golden.sh",
    "wave23:must-reject": "bash scripts/wave23-must-reject.sh",
    "wave24:golden": "bash scripts/wave24-golden.sh",
    "wave24:must-reject": "bash scripts/wave24-must-reject.sh",
    "wave25:golden": "bash scripts/wave25-golden.sh",
    "wave25:must-reject": "bash scripts/wave25-must-reject.sh",
    "wave26:golden": "bash scripts/wave26-golden.sh",
    "wave26:must-reject": "bash scripts/wave26-must-reject.sh"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@esbuild/android-arm64": "^0.27.2"
  }
}
